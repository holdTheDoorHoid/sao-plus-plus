(version 1)

# Most of this board is hidden: its "front" is pressed against the back of a bare Mad Cat. The rules below cover the
# few places where parts sit inside each other's keep-out boxes on purpose; every copper clearance is still checked
# at full rules.

(rule "Copper art (the maker's Metroid icon)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# The connector sits exactly where the Mad Cat's own connector is, under the teeth. Its keep-out box (drawn round its
# long pads across the full 16.3 mm) overlaps the boxes of tooth LED D6 and its resistor R6 by about 1 mm; the LED body
# ends 1.3 mm and the resistor 0.9 mm above the connector's plastic shroud.
(rule "Connector below tooth LED D6 and its resistor"
  (condition "A.Reference == 'J1' && (B.Reference == 'D6' || B.Reference == 'R6')")
  (constraint courtyard_clearance (min -3.5mm)))
