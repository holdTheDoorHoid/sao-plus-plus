(version 1)

# Same rules as hardware/frida.kicad_dru, with the panel's part numbers (J101, BT101, J201 ...).
(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# Connector above the cell clip on each board: 0.75 mm apart in metal, courtyards overlap by about 0.25 mm.
(rule "Connector above the cell clip"
  (condition "A.Reference == 'J?01' && B.Reference == 'BT?01'")
  (constraint courtyard_clearance (min -0.3mm)))
