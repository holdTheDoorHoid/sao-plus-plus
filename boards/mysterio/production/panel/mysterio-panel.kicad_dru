(version 1)

# Hand-written: tools/panelize.py does not carry hardware/mysterio.kicad_dru to the panel, and renumbers the parts
# (J1 -> J101, J201 ...). Same rule and the same reason as the single board; see that file. Rev B needs no
# courtyard-overlap rules.

(rule "Fine gaps inside the artwork"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))
