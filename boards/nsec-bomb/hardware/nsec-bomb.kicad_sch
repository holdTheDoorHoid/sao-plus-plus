  (global_label "GND" (shape passive) (at 259.08 121.92 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "93089dd6-f053-5d0c-8e62-7ccd374af282")
    (property "Intersheetrefs" "" (at 259.08 121.92 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common (VLOAD) feeds the four '+' wire pads on the timer. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 35.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "90a09804-cb22-58d2-8b97-945cd85178b8"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 39.37 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f7abf03f-70a6-515b-badc-6b879c4f51f3"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 43.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ff194c61-1f63-53d9-a067-f01e133d667a"))
  (text "J2..J9 are bare 1.6 mm copper pads on the front (nothing to buy). NorthSec's original had 0.7 mm plated holes for the same eight points." (exclude_from_sim no) (at 38.1 137.16 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1089927f-8311-5dd5-979b-9e9c85026789"))
  (text "The game: each LED circuit is open until the builder solders a jumper wire from any '+' pad to that LED's numbered pad. Cut a wire and its LED goes out." (exclude_from_sim no) (at 38.1 140.97 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b6261a44-8900-5657-8bc6-cdce10cea890"))
  (text "Pad 1 (J3) -> R1 -> D1 upper left, pad 2 (J7) -> R3 -> D3 upper right, pad 3 (J5) -> R2 -> D2 lower left, pad 4 (J9) -> R4 -> D4 lower right (front view), the pairing NorthSec used." (exclude_from_sim no) (at 38.1 144.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "02035630-46c3-5064-a346-2b477aaa4104"))
  (text "A wire can only ever join VLOAD to a resistor, so no wiring mistake between these pads can short the supply or reach the coin cell." (exclude_from_sim no) (at 38.1 148.59 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d4f64257-83b9-5b86-a74d-97e34aec000f"))
  (text "1.3 k gives about 1 mA per red LED from the cell and about 1.2 mA from the badge (NorthSec used 330 ohm on 3.3 V, about 4 mA)." (exclude_from_sim no) (at 38.1 152.4 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "320e80ab-9d15-5e5f-908b-b7c2a2192f97"))
  (sheet_instances (path "/" (page "1")))
)
