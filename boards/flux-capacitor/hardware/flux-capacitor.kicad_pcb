	(footprint "sao-plus-plus:SAOPP_BAT-01_CR2032_SMD_TE_BAT-HLD-001"
		(layer "B.Cu")
		(uuid "10e199cb-09b2-4881-a014-964b6166d677")
		(at 117.15 130.53 180)
		(descr "CR2032 retainer clip, TE/Linx BAT-HLD-001 (LCSC C7501066). Drawing: https://www.lcsc.com/datasheet/C7501066.pdf (recommended footprint: two 1.8 x 5.2 pads 21.0 apart, 17.0 dia cell pad). Pads 1 = clip = cell PLUS; pad 2 = bare 17 mm disc under the cell = cell MINUS (no paste; use ENIG). The clip fits the pads either way round: the open side must face +Y of this footprint (arrow), where the cell slides in. Keep parts and exposed copper out of the 10.5 mm radius circle.")
