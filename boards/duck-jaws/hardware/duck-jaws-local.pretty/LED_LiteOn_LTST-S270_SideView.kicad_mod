  (property "LCSC" "C125114" (at 0 0 0) (layer "F.Fab") hide (effects (font (size 0.8 0.8) (thickness 0.12))))
  (pad "1" smd rect (at -1.0 0) (size 1.1 1.1) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1.0 0) (size 1.1 1.1) (layers "F.Cu" "F.Paste" "F.Mask"))
  (fp_rect (start -0.825 -0.34) (end 0.825 0.34) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
