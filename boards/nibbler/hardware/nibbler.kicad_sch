  (text "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a9c67212-5813-56ff-a5a6-6b671c8777e0"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "feae9f9c-3fe8-500b-bef5-a168a7c85c4d"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c3b365da-60ad-5569-b14e-5c8caf44384b"))
  (text "D1, D2 = the two eyes; D3 = the third eye on the stalk. One 1.3k resistor per white LED: about 0.45 mA each on badge power, about 0.2 mA each on a fresh cell." (exclude_from_sim no) (at 38.1 49.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d0f4d959-3af7-58b1-a4f1-03494013aca5"))
  (sheet_instances (path "/" (page "1")))
