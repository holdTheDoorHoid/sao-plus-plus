  (text "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1cf28b83-294b-5418-b75c-388aaa1b7ec8"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6305402e-f94f-5372-a31d-d24edf69c573"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ea79fc20-4c03-56b9-97b8-1840b5fc40b9"))
  (text "D1 to D4 = the four jewels of the crown. One 1.3k resistor per red LED: about 1.2 mA each on badge power, about 1.0 mA each on a fresh cell." (exclude_from_sim no) (at 124.46 140.97 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e28380c5-f372-5860-947b-e4447780dfb3"))
  (sheet_instances (path "/" (page "1")))
)
