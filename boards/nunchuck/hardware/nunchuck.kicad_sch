  (text "No switch, no coin cell, no controller: the badge's I2C master talks straight to the Nunchuk at address 0x52." (exclude_from_sim no) (at 30.48 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d1eaefe9-2cd4-591e-9c2c-596cbe6a4113"))
  (text "Badge-driven: the SAO 3.3 V feeds the Nunchuk and both Qwiic sockets directly. Nothing on this board can feed a cell." (exclude_from_sim no) (at 30.48 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "72c96e9c-b7de-5ba9-96e6-6580dedc3755"))
  (text "J2 is the maker's edge-finger tongue: the Wii Nunchuk cable plug slides onto it. Finger 2 is unused by a Nunchuk." (exclude_from_sim no) (at 30.48 50.8 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ccc79c07-1e22-55fb-be9b-263a6c04b667"))
  (text "J3 and J4: Qwiic (JST SH) sockets that pass the same bus on to other I2C boards. Shells to GND." (exclude_from_sim no) (at 30.48 55.88 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a77bc441-dee6-576c-8680-02518c7c31e2"))
  (sheet_instances (path "/" (page "1")))
)
