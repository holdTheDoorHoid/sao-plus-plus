	(footprint "sao-plus-plus:SAOPP_SW-01_Slide_SP3T_CK_PCM13SMTR"
		(layer "B.Cu")
		(uuid "1a27dd22-c9aa-492e-8482-5f0fe6a2f14c")
		(at 20 37.08415 180)
		(descr "SAO / OFF / BATTERY power switch: C&K PCM13SMTR SP3T right-angle slide. Datasheet https://www.lcsc.com/datasheet/C221842.pdf : pos1 connects 1-3, pos2 connects 2-3, pos3 connects 3-4, so pin 3 is the common (load), pin 1 = SAO VCC, pin 2 = no connection (OFF), pin 4 = coin cell +. Land pattern matches KiCad Button_Switch_SMD:SW_SP3T_PCM13. Board edge belongs at y = +2.1 or closer; the knob reaches y = +3.1. Two 0.9 mm locating-peg holes go through the board.")
