  (global_label "GND" (shape passive) (at 106.68 144.78 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "a494fcd7-808a-5659-82cb-06725331903c")
    (property "Intersheetrefs" "" (at 106.68 144.78 0) (effects (font (size 1.27 1.27)) hide)))
  (text "Power: SW1 common = the 3.3 V rail. SAO = badge 3.3 V feeds the rail (and the XIAO through its 3V3 pin). OFF ties D1 to the rail through R13. USB-BAT leaves the badge disconnected; the XIAO runs from USB-C or the LiPo on J5." (exclude_from_sim no) (at 25.4 215.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "00856e92-aebf-533c-bdff-7c304dd722ae"))
  (text "Do not plug in USB with the switch on SAO while on a badge: two 3.3 V regulators would share one rail." (exclude_from_sim no) (at 25.4 219.71 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "31f1352e-722a-564d-a07e-665f85c6cf90"))
  (text "Badge I2C (SDA/SCL, J1 and Qwiic J3): XIAO D4/D5 as an I2C target. No pull-ups on this board (the badge has them); the maker's R7/R8 4k7 are gone." (exclude_from_sim no) (at 25.4 223.52 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a0b1d87d-3376-5b14-9124-b7524b1073cd"))
  (text "Private I2C (PRIV_SDA/PRIV_SCL, Qwiic J4): XIAO D0/D8 as controller (bit-banged), touch chip U3 at 0x28, pull-ups R11/R12 1.3k. They also hold the C3's start-up pins GPIO2/GPIO8 high." (exclude_from_sim no) (at 25.4 227.33 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "817a6aae-7ff7-5733-8d29-fa6201ff53ea"))
  (text "Display: CS tied to ground (only device on its wires); RST from R16/C1 at power-up (no pin left); backlight always on through R9 11 ohm as the maker had it." (exclude_from_sim no) (at 25.4 231.14000000000001 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "339ba934-c54c-510e-8b4a-d1bed4b55eba"))
  (text "Speaker on J2: D10 -> R14||R15 (165 ohm, limits current to about 19 mA) -> J2 pin 2; D2 -> JP1 -> J2 pin 1. JP1 1-2 bridged = push-pull (maker's default). Cut 1-2 and bridge 2-3 for one-sided drive." (exclude_from_sim no) (at 25.4 234.95000000000002 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "30a34518-224e-5f54-b779-78555ceed29d"))
  (text "Cue light D1 (front): 3.3 V -> R10 1.3k -> D1 -> D9 (pulled low to light). D9 is the C3's BOOT pin; pressing BOOT also lights it." (exclude_from_sim no) (at 25.4 238.76 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "518d4c5c-f538-5073-847c-46dfb46a3171"))
  (sheet_instances (path "/" (page "1")))
