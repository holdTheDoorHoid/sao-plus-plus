(version 1)

# The front copper is the maker's artwork (gold slabs, touch areas, lettering). This rule stops DRC from flagging the
# art for being art; everything electrical (pads, tracks, vias, the zones against other nets) is still checked in full.
(rule "Fine gaps inside the artwork"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))
