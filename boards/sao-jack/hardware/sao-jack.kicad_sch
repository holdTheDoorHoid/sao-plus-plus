  (global_label "GND" (shape passive) (at 210.82 99.06 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "4bed6246-0984-5e53-ac01-8455c614519c")
    (property "Intersheetrefs" "" (at 210.82 99.06 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "9571d928-e910-51f0-8a34-88328fa26d9e"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "417665eb-9f2d-5e0d-88c3-e4a7cfc91e9a"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "26b57d9d-acab-5953-ad4f-26c5c6d4b031"))
  (text "KIT PARTS: R1, R2 and D1-D4 are through-hole and are soldered by the buyer, as on hamster's original. They are not in the assembly BOM." (exclude_from_sim no) (at 38.1 119.38 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f6fc94db-43db-5a5b-b99f-eebe0d05e971"))
  (text "As on the original, each resistor feeds two LEDs side by side: R1 the two left LEDs (D1, D3), R2 the two right LEDs (D2, D4), seen from the front." (exclude_from_sim no) (at 38.1 123.19 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ed93df92-e240-5bd8-a06b-8d04394e2b76"))
  (text "Use the same colour for both LEDs of a pair: of two different colours on one resistor only the one that needs less voltage lights." (exclude_from_sim no) (at 38.1 127.0 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "080b4399-86e1-506d-9848-691277b107d3"))
  (text "680 ohm (the maker used 100 ohm; his schematic says 140): about 1 mA per red, yellow or green LED on a 3.0 V cell or the badge's 3.3 V." (exclude_from_sim no) (at 38.1 130.81 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bfbb61b9-4c58-5f6e-a1e0-441daf611cae"))
  (text "LED pad 1 (square hole) = cathode = short leg, toward the top of the board. LED lens on the front; resistor bodies on the back." (exclude_from_sim no) (at 38.1 134.62 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1b0d4ea0-f999-5666-8a11-149a00fc210d"))
  (sheet_instances (path "/" (page "1")))
