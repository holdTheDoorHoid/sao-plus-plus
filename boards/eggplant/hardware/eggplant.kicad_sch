  (global_label "GND" (shape passive) (at 137.16 203.2 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "eae2e5d7-c1a9-5aa3-9f07-d44ff2596a44")
    (property "Intersheetrefs" "" (at 137.16 203.2 0) (effects (font (size 1.27 1.27)) hide)))
  (text "Power: the switch common is the 3.3 V rail (XIAO 3V3 pin and the LEDs). Position 1 = badge 3.3 V feeds the rail. Position 2 (OFF) and position 3 (USB / BAT) leave the badge disconnected." (exclude_from_sim no) (at 38.1 215.9 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "61db7b44-2802-5cd4-a142-96b0dd4fb19e"))
  (text "On USB or a LiPo the XIAO powers the rail itself. In OFF the switch ties D1 to the rail so the firmware can blank the LEDs and sleep (the module itself has no off switch)." (exclude_from_sim no) (at 38.1 219.71 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d8fa2240-f6a6-5cd3-97a0-347e840e4119"))
  (text "Do not plug in USB with the switch on SAO while on a badge: two 3.3 V regulators would share one rail." (exclude_from_sim no) (at 38.1 223.52 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e06f8a60-21d9-5aa4-b469-f30d86c1ebcd"))
  (text "J2 is a LiPo connector wired to the XIAO's battery pads (two pad positions under the module: C3/S3 and C6). The XIAO charges the cell from USB-C. No coin cell on this board." (exclude_from_sim no) (at 38.1 227.33 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "24ed9a20-89bf-5ade-b390-5d63ea7590f1"))
  (text "D1..D5 = SK6805 side-firing RGB in place of the maker's five red/blue LEDs, chained D1 to D5 round the edge. One 100 nF each. R1: 330 ohm in the data line." (exclude_from_sim no) (at 38.1 231.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "abe3e710-4ec5-5402-a58f-6ff639372b32"))
  (text "The maker's board had a 4-pin header: the SAO GPIO pins stay unconnected, as they were. The XIAO answers on I2C at 0x36 as the maker's ATtiny85 did." (exclude_from_sim no) (at 38.1 234.95 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8e1dcc12-6771-5403-ab00-b1231dfbf5c3"))
  (text "Mode button = the XIAO's own BOOT button (no extra part)." (exclude_from_sim no) (at 38.1 238.76 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "59c7626a-0731-59ca-a36f-22f695b838ad"))
  (sheet_instances (path "/" (page "1")))
)
