  (text "BADGE POWER ONLY (recorded exception to the SAO++ standard): no coin cell, no switch." (exclude_from_sim no) (at 30.48 35.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "fa2f9ed1-4625-5559-aed4-bbca6aaa0a17"))
  (text "SAO pin 1 (3.3 V) feeds the EEPROM directly. The LEDs are lit by the badge through GPIO1 / GPIO2." (exclude_from_sim no) (at 30.48 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8f5b6ee4-b991-5f14-91c6-3ba60424da38"))
  (text "U1: 24C02 in SOT-23-5, fixed I2C address 0x50, WP tied to GND (writable), as on the maker's schematic." (exclude_from_sim no) (at 30.48 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "70f4f7eb-9ee4-516f-8936-7c2d7fc31eb1"))
  (text "No pull-ups on SDA / SCL: the badge provides them." (exclude_from_sim no) (at 30.48 43.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "99bf7300-3254-5820-9789-6b3221701851"))
