(version 1)

# The front copper on this board is artwork (gold coins, the '$'). This rule stops DRC from flagging the art for being
# art; everything electrical (pads, tracks, the GND copper against other nets) is still checked at full rules.

(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))
