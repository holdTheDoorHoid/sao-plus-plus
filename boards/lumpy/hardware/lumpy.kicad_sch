  (text "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ee564a65-9416-5b28-8c53-3fc69879a054"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bfb5f4e0-15a5-5aa3-9887-6d1c086a7c00"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "833012ea-806a-591d-9528-1008fbc4ce14"))
  (text "D1 = red, tip of the crown spike; D2 = white, behind the star on the forehead. One 1.3k resistor each: red about 1.0-1.2 mA, white about 0.2-0.45 mA." (exclude_from_sim no) (at 147.32 99.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a04f477f-2e64-5dac-b6b1-56a423bb7382"))
