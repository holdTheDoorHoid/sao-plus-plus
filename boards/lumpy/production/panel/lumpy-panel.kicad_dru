(version 1)
# Hand-written copy of ../../hardware/lumpy.kicad_dru for the panel (tools/panelize.py does not carry rules over,
# and renumbers parts J101 ... J401, BT101 ... BT401).


# The copper on this board is artwork. These rules stop DRC from flagging the art for being art;
# everything electrical (pads, tracks, the GND art against other nets) is still checked at full rules.

(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# The connector (bottom lobe) and the coin-cell clip (right lobe) each have only one spot on this board. Their keep-out
# boxes overlap by about 2 mm, but the parts do not touch: the connector's plastic shroud ends 0.1 mm short of the
# clip's lower solder pad, and the two connector pads that sit inside the clip's outline (pins 3 and 5) are unused.
# Check the clip's leg against the shroud on the first prototype.
(rule "Connector beside the coin-cell clip"
  (condition "A.Reference == 'J?01' && B.Reference == 'BT?01'")
  (constraint courtyard_clearance (min -2.2mm)))
