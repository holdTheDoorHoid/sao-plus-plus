(version 1)
# Hand-written copy of ../../hardware/lumpy.kicad_dru for the panel (tools/panelize.py does not carry rules over,
# and renumbers parts J101 ... J401, BT101 ... BT401).


# The copper on this board is artwork. This rule stops DRC from flagging the art for being art;
# everything electrical (pads, tracks, the GND art against other nets) is still checked at full rules.
# (Rev A also let the connector's and the cell clip's keep-out boxes overlap; rev B, scaled 1.3x, does not need that.)

(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))
