  (global_label "GND" (shape passive) (at 203.2 119.38 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "802136b9-0333-57ad-b020-7faaa4681737")
    (property "Intersheetrefs" "" (at 203.2 119.38 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common feeds the four LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "72b7d63b-da7b-5c6d-97aa-f71b61675e95"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 41.910000000000004 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4b4a85de-776e-50e8-972e-3a60b1634862"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "60b2d219-3f1a-59b2-8f93-e912dceb72b0"))
  (text "davedarko's schematic: four LEDs in parallel straight across VCC and GND, no resistor, each lit whenever the board has power." (exclude_from_sim no) (at 38.1 124.46 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bbd4fbfe-e2b2-5f2f-b884-20fab08b2ae8"))
  (text "Here each LED gets its own 1.3 k resistor (about 0.45 mA white on badge power, about 0.2 mA on a fresh cell) and all four are wired the same way:" (exclude_from_sim no) (at 38.1 128.26999999999998 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "218b09aa-da66-55d3-9e03-1a47abfad2f1"))
  (text "anode through its resistor to the switched supply, cathode to GND. White through-board LEDs light the four corners from behind." (exclude_from_sim no) (at 38.1 132.07999999999998 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5dde6ae2-7516-5f39-be4b-5bc31b317223"))
  (sheet_instances (path "/" (page "1")))
)
