  (text "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "80503624-7b85-536c-bbd2-5c69915c3dc7"))
