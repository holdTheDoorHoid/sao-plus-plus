(version 1)

# The copper on this board is artwork. These rules stop DRC from flagging the art for being art;
# everything electrical (pads, tracks, the GND copper against other nets) is still checked at full rules.

(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# The two eye LEDs sit right beside the coin-cell clip: the eyes are where the maker drew them, and the clip cannot go
# any higher (its cell would cover the hole in the loop). The keep-out boxes below overlap; the parts do not:
# - left eye (front view) LED D1 below the clip's closed end: 0.77 mm between the LED's pads and the clip's metal;
#   courtyards overlap by about 0.31 mm
(rule "Left-eye LED below the cell clip"
  (condition "A.Reference == 'D1' && B.Reference == 'BT1'")
  (constraint courtyard_clearance (min -0.5mm)))
# - right eye LED D2 beside the clip's side: 0.75 mm between the LED's pads and the clip's metal;
#   courtyards overlap by about 0.29 mm
(rule "Right-eye LED beside the cell clip"
  (condition "A.Reference == 'D2' && B.Reference == 'BT1'")
  (constraint courtyard_clearance (min -0.5mm)))
