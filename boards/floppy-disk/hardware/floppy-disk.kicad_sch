  (global_label "GND" (shape passive) (at 203.2 96.52 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ba7fb24b-649a-523b-8a9f-03e69ee7644e")
    (property "Intersheetrefs" "" (at 203.2 96.52 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common feeds the board. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell (through D1)." (exclude_from_sim no) (at 25.4 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "eab8ae7a-1fe4-5237-8aca-1463604e48e9"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 25.4 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d44bd60a-5b3b-5a30-b1e2-2796e685d94d"))
  (text "D1 (series Schottky, docs/standard.md section 3) is required: both EEPROMs sit on SDA / SCL, and the 24C02's inputs have protection diodes to its supply pin." (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7c97fc9d-87d5-5b43-b1ad-6003c2b4280f"))
  (text "No I2C pull-ups on the add-on (the maker's R2 / R3, 10 k, are removed): the badge provides them." (exclude_from_sim no) (at 25.4 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5800dc2e-5f62-56db-817f-9aa8c06286bc"))
  (text "Maker's circuit (Uri Shaked, 2020): U1 = 256-byte ID EEPROM at 0x50, U2 = 64 KB storage EEPROM at 0x51 (E0 high). JP1 / JP2: bridge with solder to write-protect." (exclude_from_sim no) (at 101.6 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ba76d72f-e758-5ab2-8277-cda1c8cd7280"))
  (text "U1 is now SOT-23-5 (SAOPP-EE-01 candidate): its address is fixed at 0x50 inside the chip. WP pins float when the bridges are open, as on the maker's board." (exclude_from_sim no) (at 101.6 49.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2ecee7b7-8a7e-5356-9e8a-e6d99cb1bded"))
  (sheet_instances (path "/" (page "1")))
)
