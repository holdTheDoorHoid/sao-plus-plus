 "notes": [
  [
   "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell.",
   [
    38.1,
    38.1
   ]
  ],
  [
   "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other.",
   [
    38.1,
    41.91
   ]
  ],
  [
   "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3).",
   [
    38.1,
    45.72
   ]
  ],
  [
   "D1, D2 = near eye; D3 = far eye (white); D4 = fuse spark (red). One 1.3k resistor per LED: white about 0.45 mA, red about 1.2 mA on badge power.",
   [
    147.32,
    140.97
   ]
  ]
 ]
