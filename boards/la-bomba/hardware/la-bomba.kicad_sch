  (text "SAO++ power select: the switch common feeds the LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d479bcd3-c556-597f-aae5-d4a9e7f98053"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d1b15620-9178-5136-8410-4c22fcc27e1d"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected, so no series diode is needed on the cell (see docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a98b282f-0a99-5285-bd81-29e5d5d72151"))
  (text "D1, D2 = near eye; D3 = far eye (white); D4 = fuse spark (red). One 1.3k resistor per LED: white about 0.45 mA, red about 1.2 mA on badge power." (exclude_from_sim no) (at 147.32 140.97 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d7ab001c-f38f-5ae3-92ad-2091617ae38a"))
  (sheet_instances (path "/" (page "1")))
)
