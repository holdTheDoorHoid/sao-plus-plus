  (global_label "GND" (shape passive) (at 261.62 81.28 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5a3efd58-a2c3-5f34-b176-502cd8887b7d")
    (property "Intersheetrefs" "" (at 261.62 81.28 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common (VLOAD) feeds the timer and both LEDs. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "eb3dd416-7cf2-568b-a72f-7f3a6f0ed1cb"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c4a328d7-402f-5a25-b58d-c690e31cd7cc"))
  (text "Nothing is wired to SDA, SCL, GPIO1 or GPIO2, so no series diode is needed on the cell (docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "abdb0014-77b0-5769-9de7-652408beee3e"))
  (text "555 astable, as the maker drew it: R1 = RA (VLOAD to DIS), R2 = RB (DIS to THR/TRIG), C1 = timing capacitor." (exclude_from_sim no) (at 116.84 127.0 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3df68da3-8bce-5127-ad33-da496a9db69e"))
  (text "3.3M + 3.3M + 100n: D2 on 0.46 s, off 0.23 s (about 1.5 blinks a second). The maker's built board (1k, 470k, 1u) gave 0.33 s on, 0.33 s off." (exclude_from_sim no) (at 116.84 130.81 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "441e0808-8c03-539f-b6be-3919533c7452"))
  (text "D1 = control line C, always lit (R3). D2 = test line T, blinks from the 555 output (R4). Red LEDs, 1.3k each: about 1 mA from a cell." (exclude_from_sim no) (at 116.84 134.62 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e9c320a5-a119-5852-bee4-2d941cd5880f"))
