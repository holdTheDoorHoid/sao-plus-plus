  (global_label "WP" (shape passive) (at 198.12 104.14 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "65e42dae-6b7a-524c-83e5-2665535601c9")
    (property "Intersheetrefs" "" (at 198.12 104.14 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common (VLOAD) feeds the EEPROM. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell." (exclude_from_sim no) (at 38.1 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "665d6bb4-0cc3-5ca2-965e-7ea15d20bc6d"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 38.1 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e408cc32-61ce-56b3-afd2-4e6e8b9699eb"))
  (text "D1 (series Schottky) is required: the EEPROM is wired to SDA/SCL, and the badge's I2C pull-ups must not push current into the cell (docs/standard.md section 3)." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "daf73a00-8f03-59d2-9294-15b03da088ba"))
  (text "Maker's circuit kept: CAT24C256 on SDA/SCL, C1 = supply decoupling. No pull-ups on SDA/SCL (the badge provides them)." (exclude_from_sim no) (at 127.0 127.0 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2613f9f4-5ed5-5172-88cb-fde3c3f30a1f"))
  (text "R1-R3 (A0-A2) and R4 (WP) are the maker's optional straps, NOT FITTED: the chip pulls those pins low itself, so the EEPROM answers at 0x50 and can be written." (exclude_from_sim no) (at 127.0 130.81 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c9f412b7-146d-5e49-bf82-11c2421e3ebc"))
  (text "Fit R1-R3 to move the address (0x50 + A2*4 + A1*2 + A0); fit R4 to write-protect the whole chip." (exclude_from_sim no) (at 127.0 134.62 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1c53a58d-f0b4-5c2f-a2b0-774127465f98"))
  (sheet_instances (path "/" (page "1")))
)
