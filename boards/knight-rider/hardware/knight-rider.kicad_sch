  (global_label "GND" (shape passive) (at 223.52 144.78 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7ba62729-9e9c-5b5e-9dda-0ec7e7e36a21")
    (property "Intersheetrefs" "" (at 223.52 144.78 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common feeds the board. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell (through D9)." (exclude_from_sim no) (at 25.4 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "90f94dd4-aea0-5ad3-b1b5-07aab0cd183b"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 25.4 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "54154340-606d-55cc-b44d-59722ea1766b"))
  (text "D9 (series Schottky, docs/standard.md section 3) is required: the ATtiny's PB4 is wired to SAO GPIO2, so the badge could push current into the cell through it." (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "665e3825-c0c0-5dc6-95e9-708612204d17"))
  (text "R9 (330 ohm) is the series resistor the SAO spec asks for on a GPIO the add-on may drive; the maker's 2024 board wired PB4 straight to the header." (exclude_from_sim no) (at 25.4 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8113bd5f-f793-5df5-a3e4-228c6ba78de1"))
  (text "Maker's circuit (davedarko, KiCad 8 2024): ATtiny85 drives 8 red LEDs from 4 pins; each pin lights one LED to GND when HIGH and one LED from VLOAD when LOW." (exclude_from_sim no) (at 154.94 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d33407c7-d3fe-59c1-8bb7-67e7f13e7829"))
  (text "D1..D8 are on the FRONT (art side) in the maker's scanner positions; resistors 1.3k (maker: 1k): about 0.9 mA per LED at 3.0 V, 1.15 mA at 3.3 V." (exclude_from_sim no) (at 154.94 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c0b0f7ab-816c-5801-8a5f-85fe136bed0a"))
  (text "JP1: the maker's six AVR ISP pads (bare copper). SW2: the maker's push button on PB4." (exclude_from_sim no) (at 101.6 154.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6aba6e67-1d3b-58ca-91de-3778ab7fbb94"))
  (sheet_instances (path "/" (page "1")))
)
