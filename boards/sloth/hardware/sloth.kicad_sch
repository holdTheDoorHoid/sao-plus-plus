  (global_label "NODE_A" (shape passive) (at 251.46 127.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f6398718-4725-5ff0-9bd6-de2971123f2d")
    (property "Intersheetrefs" "" (at 251.46 127.0 0) (effects (font (size 1.27 1.27)) hide)))
  (text "SAO++ power select: the switch common feeds the board. Position 1 = badge 3.3 V, position 2 = OFF (pin 2 unconnected), position 3 = coin cell (through D13)." (exclude_from_sim no) (at 25.4 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3753379c-f0ca-5612-b7dd-4960a118582c"))
  (text "The badge supply and the coin cell sit on separate switch contacts and are never connected to each other." (exclude_from_sim no) (at 25.4 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "551875c3-6fb7-5b2f-b434-4ec046fabeaf"))
  (text "D13 (series Schottky, docs/standard.md section 3) is required: the ATtiny's PB1 is wired to SAO GPIO2 through R5, so the badge could push current into the cell through the chip." (exclude_from_sim no) (at 25.4 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5c882ac0-a798-5c18-b8a5-bae62c41053e"))
  (text "R5 (330 ohm) is the SAO spec's series resistor on a GPIO the add-on may drive. PB1 is the maker's button pin; the chip has no other spare pin (PB0, PB2, PB3, PB4 drive the LEDs, PB5 is reset)." (exclude_from_sim no) (at 25.4 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "01adea98-670e-5335-a52a-29a12abfb7a3"))
  (text "Maker's circuit (davedarko, Eagle 2017, REV1): ATtiny85 charlieplexes 12 LEDs from PB0, PB2, PB3, PB4, each through its own resistor to one node (maker's nets N$9, N$11, N$12, N$2 = NODE_A..D)." (exclude_from_sim no) (at 154.94 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "885c3076-ef79-5081-bc73-3f9be952910b"))
  (text "Resistors 330 ohm (maker: 150 ohm); a lit LED sees two in series: about 2.3 mA at 3.3 V, about 1.4 mA on the cell after D13. D1..D12 are on the FRONT where the maker had LED1..LED12." (exclude_from_sim no) (at 154.94 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ae88c1d6-c429-53ab-8be9-0aa1b2d16ac5"))
  (text "JP1: the maker's six AVR ISP pads (bare copper). SW2: the maker's push button on PB1 (pressed = low)." (exclude_from_sim no) (at 101.6 154.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "73b28b1f-5ba7-5faa-a661-9d14d6f094a7"))
  (sheet_instances (path "/" (page "1")))
)
