(version 1)

# Hand-written copy of hardware/sloth.kicad_dru for the panel (tools/panelize.py does not carry board rules over, and
# renumbers each board's parts: J1 -> J101, J201, ...).

# The front copper and mask are the maker's artwork.
(rule "Fine gaps inside the artwork"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# Real gaps (see hardware/sloth.kicad_dru): J1-BT1 0.27 mm body to body, D13-BT1 0.40 mm pad to clip body,
# R5-J1 0.72 mm pad to pad. Courtyards overlap; parts do not touch.
(rule "Tight parts beside the connector and the cell clip"
  (condition "(A.Reference == 'J?01' && (B.Reference == 'BT?01' || B.Reference == 'R?05')) || (B.Reference == 'J?01' && (A.Reference == 'BT?01' || A.Reference == 'R?05')) || (A.Reference == 'BT?01' && B.Reference == 'D?13') || (B.Reference == 'BT?01' && A.Reference == 'D?13')")
  (constraint courtyard_clearance (min -2.0mm)))
