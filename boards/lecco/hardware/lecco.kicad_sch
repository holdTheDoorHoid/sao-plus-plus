  (text "Badge-powered only, like the maker's original: the board is too small for the CR2032 clip without covering the maker's handwritten message (see README)." (exclude_from_sim no) (at 38.1 38.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a3190026-afd8-5ef2-8d87-fdffeee0ef64"))
  (text "LED-only board: SDA, SCL, GPIO1 and GPIO2 are not connected." (exclude_from_sim no) (at 38.1 41.91 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "31ad9e33-4550-5ff2-be1b-c54badb944bf"))
  (text "D1 is the LED the maker meant to be bodged across his two VCC / GND pads: a reverse-mount LED behind the bare-board word ITALY." (exclude_from_sim no) (at 38.1 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "008956b2-64d8-5efc-aa26-b3197dc6183b"))
  (text "1.3 k (shared part, was an unspecified 'R' or a solder bridge on the original) gives about 0.45 mA through a white LED from 3.3 V." (exclude_from_sim no) (at 38.1 49.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "99d63509-7798-55d9-8397-b232db7761ee"))
