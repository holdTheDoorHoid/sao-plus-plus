(version 1)

# The copper on this board is artwork. These rules stop DRC from flagging the art for being art;
# everything electrical (pads, tracks, the GND copper against other nets) is still checked at full rules.

(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# Rev A also had two rules letting the parts' keep-out boxes overlap (cell clip, connector, left-eye LED). Rev B is
# scaled up 1.4x and the keep-out boxes no longer overlap, so those rules are gone.
