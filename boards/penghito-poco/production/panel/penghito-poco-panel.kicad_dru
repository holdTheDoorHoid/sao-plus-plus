(version 1)

# Panel copy of hardware/penghito-poco.kicad_dru, written by hand: tools/panelize.py does not carry rules over and
# renumbers the parts per board (J1 -> J101, J201 ...; BT1 -> BT101 ...; D1 -> D101 ...), so the references use '?'.

# The copper on this board is artwork. These rules stop DRC from flagging the art for being art;
# everything electrical (pads, tracks, the GND copper against other nets) is still checked at full rules.

(rule "Fine gaps inside the artwork (lettering, line art)"
  (condition "A.Type == 'Graphic' && B.Type == 'Graphic'")
  (constraint clearance (min 0.01mm)))

# Rev A had two more rules here letting the parts' keep-out boxes overlap. Rev B is scaled up 1.4x and they no longer
# overlap, so those rules are gone (as in hardware/penghito-poco.kicad_dru).
